<%- include('../partials/head', { title, pageCss: 'checkout' }) %>
<section class="checkout-page page-shell">
  <div class="checkout-heading"><p class="eyebrow">Secure checkout</p><h1>Review your project package.</h1><p>Confirm your selection, then continue to Flutterwave for secure payment. No payment details are stored by VJU Tech.</p></div>
  <div class="checkout-grid">
    <section class="order-panel" aria-labelledby="order-title"><div class="panel-heading"><div><p class="eyebrow">Your selection</p><h2 id="order-title"><%= cart.package.name %> package</h2></div><a class="edit-link" href="/#packages">Edit selection <span>↗</span></a></div><div class="order-row"><span><b><%= cart.package.name %> website package</b><small>Professional website development</small></span><strong>$<%= cart.package.price %></strong></div><div class="checkout-addons"><div class="addons-heading"><h3>Optional add-ons</h3><span><%= cart.addOns.length %> selected</span></div><% if (cart.addOns.length) { cart.addOns.forEach((addOn) => { %><div class="order-row"><span><b><%= addOn.name %></b></span><strong>$<%= addOn.price %></strong></div><% }); } else { %><p class="empty-addons">No optional add-ons selected.</p><% } %></div><div class="checkout-total"><span>Total project estimate</span><strong>$<%= cart.total %> <small>USD</small></strong></div></section>
    <form class="payment-panel" action="/checkout/pay" method="post"><div class="panel-heading"><div><p class="eyebrow">Project details</p><h2>Almost there.</h2></div><span class="secure-badge">Secure <span>✓</span></span></div><% if (checkout && checkout.error) { %><p class="form-message form-error"><%= checkout.error %></p><% } %><input name="_csrf" type="hidden" value="<%= csrfToken %>"><label for="checkout-name">Full name</label><input id="checkout-name" name="name" required autocomplete="name"><label for="checkout-email">Email address</label><input id="checkout-email" name="email" type="email" required autocomplete="email"><label for="checkout-company">Company <small>Optional</small></label><input id="checkout-company" name="company" autocomplete="organization"><div class="payment-note"><span aria-hidden="true">◆</span><p>You will be redirected to Flutterwave to pay securely by card, bank transfer, USSD, or mobile money.</p></div><% if (paymentReady) { %><button class="button button-dark checkout-submit" type="submit">Pay $<%= cart.total %> securely <span>→</span></button><% } else { %><button class="button button-dark checkout-submit" type="submit" disabled>Payment setup pending</button><% } %><small class="checkout-footnote">By continuing, you agree that the project scope will be confirmed with our team before development begins.</small></form>
  </div>
</section>
<%- include('../partials/foot') %>
