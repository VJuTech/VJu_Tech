<%- include('../partials/head', { title, pageCss: 'inquiry' }) %>
<section class="contact-layout page-shell"><div><p class="eyebrow">Start a project</p><h1>Give us the shape of the problem.</h1><p>A few useful details help us understand the opportunity and come back with the right next step.</p></div><form class="contact-form" action="/inquiry" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><% if (inquiry && inquiry.error) { %><p class="form-message form-error"><%= inquiry.error %></p><% } %><% if (inquiry && inquiry.success) { %><p class="form-message form-success"><%= inquiry.success %></p><% } %><label for="name">Name</label><input id="name" name="name" required><label for="email">Email</label><input id="email" name="email" type="email" required><label for="company">Company</label><input id="company" name="company"><label for="budget">Budget (optional)</label><input id="budget" name="budget" type="number" min="0" step="0.01"><label for="project-description">Project description</label><textarea id="project-description" name="projectDescription" rows="7" required></textarea><button class="button button-dark" type="submit">Send project inquiry <span>↗</span></button></form></section>
<%- include('../partials/foot') %>