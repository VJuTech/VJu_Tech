<%- include('../partials/head', { title, pageCss: 'project' }) %>
<section class="page-heading page-shell"><p class="eyebrow">Client project</p><h1><%= project.name %></h1><p><%= project.description || 'Project delivery workspace' %></p></section>
<section class="project-detail page-shell"><div><p class="case-number">Status</p><h2><%= project.status.replace('_', ' ') %></h2><p>Progress: <%= project.progress %>%</p></div><div class="message-panel"><h2>Project conversation</h2><% messages.forEach((message) => { %><p class="message"><strong><%= message.sender_name %></strong><br><%= message.body %></p><% }) %><form class="contact-form" action="/dashboard/projects/<%= project.id %>/messages" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><label for="body">Message</label><textarea id="body" name="body" rows="4" required></textarea><button class="button button-dark" type="submit">Send message</button></form></div></section>
<%- include('../partials/foot') %>