<%- include('../partials/head', { title, pageCss: 'management-list' }) %>
<section class="page-heading page-shell"><p class="eyebrow">Admin / enquiries</p><h1>Service inquiries.</h1><p>Move each opportunity through a clear follow-up workflow.</p></section><section class="data-list page-shell"><% if (!inquiries.length) { %><p class="empty-state">No service inquiries have been submitted.</p><% } %><% inquiries.forEach((inquiry) => { %><article><div><strong><%= inquiry.name %></strong><span><%= inquiry.email %><%= inquiry.company ? ` · ${inquiry.company}` : '' %></span></div><p><%= inquiry.project_description %></p><small><%= inquiry.status %> · <%= inquiry.budget ? `$${Number(inquiry.budget).toLocaleString()}` : 'Budget not provided' %> · <%= new Date(inquiry.created_at).toLocaleDateString() %></small><form class="status-form" action="/admin/inquiries/<%= inquiry.id %>/status" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="inquiry-status-<%= inquiry.id %>">Update status</label><select id="inquiry-status-<%= inquiry.id %>" name="status"><% ['new', 'contacted', 'converted', 'closed'].forEach((status) => { %><option value="<%= status %>"<%= status === inquiry.status ? ' selected' : '' %>><%= status %></option><% }) %></select><button class="button button-dark" type="submit">Save status <span aria-hidden="true">→</span></button></form></article><% }) %></section>
<%- include('../partials/foot') %>