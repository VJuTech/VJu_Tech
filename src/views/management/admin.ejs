<%- include('../partials/head', { title, pageCss: 'admin' }) %>
<section class="admin-heading page-shell"><div><p class="eyebrow">Admin / Overview</p><h1>Keep the work moving.</h1><p>One clear view of demand, delivery, payments, and the client experience.</p></div><a class="button button-blue" href="/admin/projects/new">New project <span aria-hidden="true">+</span></a></section>
<section class="admin-kpis page-shell" aria-label="Business overview">
	<article><span class="kpi-icon" aria-hidden="true">◎</span><div><strong><%= summary.new_inquiries %></strong><span>New inquiries</span></div><a href="/admin/inquiries">Review queue →</a></article>
	<article><span class="kpi-icon green" aria-hidden="true">↗</span><div><strong><%= summary.active_projects %></strong><span>Active projects</span></div><a href="/admin/projects">View delivery →</a></article>
	<article><span class="kpi-icon" aria-hidden="true">◇</span><div><strong><%= summary.clients %></strong><span>Client accounts</span></div><a href="/admin/users">Manage users →</a></article>
	<article><span class="kpi-icon green" aria-hidden="true">$</span><div><strong>$<%= Number(summary.paid_revenue).toLocaleString() %></strong><span>Paid revenue</span></div><a href="/admin/reports">See reports →</a></article>
</section>
<section class="admin-workspace page-shell">
	<div class="admin-main-column">
		<div class="admin-section-heading"><div><p class="eyebrow">Sales pipeline</p><h2>Recent inquiries</h2></div><a href="/admin/inquiries">View all →</a></div>
		<div class="admin-table"><% if (!inquiries.length) { %><p class="empty-state">No inquiries have been submitted yet.</p><% } %><% inquiries.slice(0, 5).forEach((inquiry) => { %><article><div class="record-avatar"><%= inquiry.name.charAt(0).toUpperCase() %></div><div class="record-content"><strong><%= inquiry.name %></strong><span><%= inquiry.company || inquiry.email %></span></div><span class="status status-<%= inquiry.status %>"><%= inquiry.status %></span><small><%= new Date(inquiry.created_at).toLocaleDateString() %></small></article><% }) %></div>
		<div class="admin-section-heading admin-section-heading-spaced"><div><p class="eyebrow">Delivery</p><h2>Project pipeline</h2></div><a href="/admin/projects">View all →</a></div>
		<div class="admin-table"><% if (!projects.length) { %><p class="empty-state">No projects have been created yet.</p><% } %><% projects.slice(0, 5).forEach((project) => { %><article><div class="record-avatar project-avatar"><%= project.progress %>%</div><div class="record-content"><strong><%= project.name %></strong><span><%= project.client_name %></span></div><div class="progress-track"><i style="width: <%= project.progress %>%"></i></div><span class="status status-<%= project.status %>"><%= project.status.replace('_', ' ') %></span></article><% }) %></div>
	</div>
	<aside class="admin-side-column">
		<div class="admin-section-heading"><div><p class="eyebrow">Payments</p><h2>Checkout activity</h2></div></div>
		<div class="checkout-feed"><% if (!checkouts.length) { %><p class="empty-state">No checkout activity yet.</p><% } %><% checkouts.forEach((checkout) => { %><article><div><strong><%= checkout.customer_name || 'Guest checkout' %></strong><span><%= checkout.package_name %> · $<%= Number(checkout.total).toLocaleString() %></span></div><span class="status status-<%= checkout.payment_status %>"><%= checkout.payment_status %></span></article><% }) %></div>
		<div class="quick-links"><p class="eyebrow">Workspace</p><a href="/admin/content">Content library <span>→</span></a><a href="/admin/messages">Client messages <span><%= summary.recent_messages %> / 30 days</span></a><a href="/admin/reports">Audit and reports <span>→</span></a></div>
	</aside>
</section>
<section class="admin-activity page-shell"><div class="admin-section-heading"><div><p class="eyebrow">System trail</p><h2>Recent activity</h2></div><a href="/admin/reports">Open reports →</a></div><div class="activity-row"><% if (!activity.length) { %><p class="empty-state">No audited activity yet.</p><% } %><% activity.slice(0, 5).forEach((item) => { %><article><span class="activity-dot"></span><div><strong><%= item.action.replaceAll('.', ' ') %></strong><span><%= item.actor_name || 'System' %> · <%= new Date(item.created_at).toLocaleString() %></span></div></article><% }) %></div></section>
<%- include('../partials/foot') %>