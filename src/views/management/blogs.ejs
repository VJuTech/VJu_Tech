<%- include('../partials/head', { title, pageCss: 'blog' }) %>
<% const categoryLabels = { 'web-development': 'Web development', business: 'Business tips', tutorials: 'Tutorials', 'case-studies': 'Case studies', 'industry-trends': 'Industry trends', 'company-updates': 'Company updates' }; const featuredPost = posts.find((post) => post.featured) || posts[0]; const recentPosts = featuredPost ? posts.filter((post) => post.id !== featuredPost.id) : posts; const categoryCounts = posts.reduce((counts, post) => { counts[post.category] = (counts[post.category] || 0) + 1; return counts; }, {}); %>
<section class="page-heading page-shell"><p class="eyebrow">Insights / Ideas in practice</p><h1>Thinking that helps good work travel further.</h1><p>Practical guidance on digital products, business growth, and the decisions that make technology useful.</p></section>
<section class="blog-topics page-shell" aria-label="Blog categories"><p class="eyebrow">Explore by topic</p><nav class="topic-list"><% Object.keys(categoryLabels).forEach((category) => { if (categoryCounts[category]) { %><a href="#<%= category %>"><span><%= categoryLabels[category] %></span><small><%= categoryCounts[category] %></small></a><% } }) %></nav></section>
<% if (!posts.length) { %><section class="article-list page-shell"><p class="empty-state">Published insights will appear here soon.</p></section><% } else { %>
  <section class="featured-article page-shell">
    <p class="eyebrow">Featured article</p>
    <article>
      <div class="featured-copy"><p class="article-category"><%= categoryLabels[featuredPost.category] || 'Insight' %></p><h2><%= featuredPost.title %></h2><p class="featured-excerpt"><%= featuredPost.excerpt || featuredPost.body.slice(0, 220) %></p><p class="article-date"><%= featuredPost.published_at ? new Date(featuredPost.published_at).toLocaleDateString() : '' %></p><a class="text-link" href="#article-<%= featuredPost.id %>">Read the insight <span aria-hidden="true">↗</span></a></div>
      <% if (featuredPost.has_image) { %><img class="featured-image" src="/content-image/blog/<%= featuredPost.id %>" alt="<%= featuredPost.title %>"><% } else if (featuredPost.image_key) { %><img class="featured-image" src="<%= featuredPost.image_key %>" alt="<%= featuredPost.title %>"><% } else { %><div class="featured-art" aria-hidden="true"><span>VJU</span></div><% } %>
    </article>
  </section>
  <section class="article-list page-shell" id="recent-articles"><div class="section-heading"><div><p class="eyebrow">Keep exploring</p><h2>Recent articles</h2></div><p>Ideas, lessons, and observations from the work.</p></div><div class="article-grid"><% recentPosts.forEach((post) => { %><article id="article-<%= post.id %>"><% if (post.has_image) { %><img class="content-image" src="/content-image/blog/<%= post.id %>" alt="<%= post.title %>"><% } else if (post.image_key) { %><img class="content-image" src="<%= post.image_key %>" alt="<%= post.title %>"><% } %><p class="article-category"><%= categoryLabels[post.category] || 'Insight' %></p><h3><%= post.title %></h3><p><%= post.excerpt || post.body.slice(0, 180) %></p><p class="article-date"><%= post.published_at ? new Date(post.published_at).toLocaleDateString() : '' %></p></article><% }) %></div></section>
<% } %>
<section class="content-types page-shell"><div><p class="eyebrow">What you’ll find here</p><h2>Useful ideas, not noise.</h2></div><div class="content-type-list"><p><strong>01</strong><span><b>Educational articles</b>Search-friendly guidance for building and growing online.</span></p><p><strong>02</strong><span><b>Case studies</b>A closer look at the decisions behind our projects.</span></p><p><strong>03</strong><span><b>Tutorials & trends</b>Practical techniques and a clear view of what is next.</span></p></div></section>
<section class="blog-cta page-shell"><div><p class="eyebrow">Have a question?</p><h2>Let’s make your next decision clearer.</h2></div><a class="button button-dark" href="/inquiry">Start your project <span>↗</span></a></section>
<%- include('../partials/foot') %>
