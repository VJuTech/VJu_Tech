<%- include('../partials/head', { title, pageCss: 'content-admin' }) %>
<% const isPortfolio = type === 'portfolio'; const action = item ? `/admin/content/${type}/${item.id}` : `/admin/content/new/${type}`; const currentImage = item?.image_key || item?.imageKey || ''; const previewImage = item?.has_image ? '/content-image/' + type + '/' + item.id : currentImage; %>
<section class="page-heading page-shell"><p class="eyebrow">Admin / <%= isPortfolio ? 'portfolio' : 'blog' %></p><h1><%= item ? 'Refine this piece.' : `Create a ${isPortfolio ? 'case study' : 'blog post'}.` %></h1><p>Save as a draft while you work, then publish when the content is ready for the public site.</p></section>
<form class="content-editor page-shell" action="<%= action %>" method="post" enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (error) { %><p class="form-error"><%= error %></p><% } %>
  <div class="editor-main">
    <label for="content-title">Title</label>
    <input id="content-title" name="title" value="<%= item?.title || '' %>" required>
    <label for="content-slug">URL slug</label>
    <input id="content-slug" name="slug" value="<%= item?.slug || '' %>" placeholder="A clean URL is generated from the title">
    <small>Use lowercase words separated by hyphens.</small>
    <% if (isPortfolio) { %>
      <label for="content-summary">Short summary</label>
      <textarea id="content-summary" name="summary" rows="3" required><%= item?.summary || '' %></textarea>
      <label for="content-description">Full description</label>
      <textarea id="content-description" name="description" rows="8"><%= item?.description || '' %></textarea>
      <div class="editor-field-grid">
        <div><label for="content-problem">Client problem</label><textarea id="content-problem" name="problem" rows="5"><%= item?.problem || '' %></textarea></div>
        <div><label for="content-solution">Your solution</label><textarea id="content-solution" name="solution" rows="5"><%= item?.solution || '' %></textarea></div>
        <div><label for="content-result">Result / impact</label><textarea id="content-result" name="result" rows="5"><%= item?.result || '' %></textarea></div>
      </div>
      <label for="content-role">Your role</label>
      <input id="content-role" name="role" value="<%= item?.role || '' %>" placeholder="Lead developer & product designer">
      <div class="editor-field-grid editor-field-grid-compact">
        <div><label for="content-timeline">Timeline</label><input id="content-timeline" name="timeline" value="<%= item?.timeline || '' %>" placeholder="8 weeks"></div>
        <div><label for="content-technologies">Technologies</label><input id="content-technologies" name="technologies" value="<%= item?.technologies || '' %>" placeholder="HTML, CSS, Node.js, PostgreSQL"></div>
      </div>
      <label for="content-client-name">Client / brand name</label>
      <input id="content-client-name" name="clientName" value="<%= item?.client_name || item?.clientName || '' %>" placeholder="Delta Chamber">
      <label for="content-client-logo">Client logo path or URL</label>
      <input id="content-client-logo" name="clientLogo" value="<%= item?.client_logo || item?.clientLogo || '' %>" placeholder="/images/site/client-logo.svg">
      <label for="content-testimonial">Client testimonial</label>
      <textarea id="content-testimonial" name="testimonial" rows="4" placeholder="A short quote from the client"><%= item?.testimonial || '' %></textarea>
      <label for="content-testimonial-author">Testimonial attribution</label>
      <input id="content-testimonial-author" name="testimonialAuthor" value="<%= item?.testimonial_author || item?.testimonialAuthor || '' %>" placeholder="Name, role — Company">
      <label for="content-link">Project link</label>
      <input id="content-link" name="projectLink" type="url" value="<%= item?.project_link || '' %>" placeholder="https://example.com">
    <% } else { %>
      <label for="content-excerpt">Excerpt</label>
      <textarea id="content-excerpt" name="excerpt" rows="3"><%= item?.excerpt || '' %></textarea>
      <div class="editor-field-grid editor-field-grid-compact">
        <div><label for="content-category">Category</label><select id="content-category" name="category"><% const categories = [{ value: 'web-development', label: 'Web development' }, { value: 'business', label: 'Business tips' }, { value: 'tutorials', label: 'Tutorials' }, { value: 'case-studies', label: 'Case studies' }, { value: 'industry-trends', label: 'Industry trends' }, { value: 'company-updates', label: 'Company updates' }]; categories.forEach((category) => { %><option value="<%= category.value %>"<%= (item?.category || 'web-development') === category.value ? ' selected' : '' %>><%= category.label %></option><% }) %></select></div>
        <div><label class="editor-check-label"><input type="checkbox" name="featured"<%= item?.featured ? ' checked' : '' %>> Feature this article</label><small>Featured articles lead the public blog page.</small></div>
      </div>
      <label for="content-body">Article body</label>
      <textarea id="content-body" name="body" rows="16" required><%= item?.body || '' %></textarea>
      <small>Plain text is supported. Keep paragraphs short for comfortable reading.</small>
    <% } %>
    <label for="content-image">Image path or URL</label>
    <input id="content-image" name="imageKey" value="<%= currentImage %>" placeholder="/images/site/project-name.jpg">
    <small>Use an existing URL/path, or upload an image below. An uploaded image takes priority.</small>
    <label for="content-image-file">Upload image</label>
    <input id="content-image-file" name="imageFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif">
    <small>JPG, PNG, WebP, or GIF up to 5 MB.</small>
    <% if (previewImage) { %><img class="editor-image-preview" src="<%= previewImage %>" alt="Current content image"><% } %>
    <div class="editor-publish"><label><input type="checkbox" name="published"<%= item?.published ? ' checked' : '' %>> Publish this content</label><span>Published entries appear on the public <%= isPortfolio ? 'portfolio' : 'blog' %> page.</span></div>
    <% if (isPortfolio) { %><div class="editor-publish"><label><input type="checkbox" name="featured"<%= item?.featured ? ' checked' : '' %>> Feature this project</label><span>Featured projects are shown first, up to 10 total.</span></div><label for="content-sort-order">Featured order</label><input id="content-sort-order" name="sortOrder" type="number" min="0" value="<%= item?.sort_order ?? 0 %>"><% } %>
    <div class="editor-actions"><button class="button button-blue" type="submit"><%= item ? 'Save changes' : 'Create draft' %> <span aria-hidden="true">→</span></button><a class="button button-dark" href="/admin/content">Cancel</a></div>
  </div>
  <aside class="editor-guide"><p class="eyebrow">Publishing checklist</p><h2>Make it useful.</h2><ul><li>Use a specific, honest title.</li><li>Write for the people you want to reach.</li><li>Check links and image paths before publishing.</li><li>Keep drafts private until they are ready.</li></ul></aside>
</form>
<%- include('../partials/foot') %>
