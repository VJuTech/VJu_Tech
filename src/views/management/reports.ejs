<%- include('../partials/head', { title, pageCss: 'management-list' }) %>
<section class="page-heading page-shell"><p class="eyebrow">Admin / reports</p><h1>Operational visibility.</h1><p>Recent workload, delivery activity, and system events from PostgreSQL.</p></section>
<section class="report-grid page-shell"><article><strong><%= summary.users %></strong><span>Users</span></article><article><strong><%= summary.new_inquiries %></strong><span>New inquiries</span></article><article><strong><%= summary.open_projects %></strong><span>Open projects</span></article><article><strong><%= summary.recent_messages %></strong><span>Messages in 30 days</span></article><article><strong><%= summary.recent_files %></strong><span>Files in 30 days</span></article></section>
<section class="data-list page-shell"><h2>Recent activity</h2><% if (!activity.length) { %><p class="empty-state">No audited activity yet.</p><% } %><% activity.forEach((item) => { %><article><div><strong><%= item.action %></strong><span><%= item.actor_name || 'System' %></span></div><p><%= item.entity_type || 'system' %><%= item.entity_id ? ` #${item.entity_id}` : '' %></p><small><%= item.created_at.toISOString() %></small></article><% }) %></section>
<%- include('../partials/foot') %>
