<%- include('../partials/head', { title, pageCss: 'management-list' }) %>
<section class="page-heading page-shell"><p class="eyebrow">Admin / projects</p><h1>Delivery at a glance.</h1></section><section class="data-list page-shell"><% if (!projects.length) { %><p class="empty-state">No projects have been created.</p><% } %><% projects.forEach((project) => { %><article><div><strong><%= project.name %></strong><span><%= project.client_name %></span></div><p><%= project.status.replace('_', ' ') %></p><small><%= project.progress %>% complete · Due <%= project.due_date || 'not set' %></small></article><% }) %></section>
<%- include('../partials/foot') %>