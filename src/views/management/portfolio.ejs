<%- include('../partials/head', { title, pageCss: 'portfolio' }) %>
<section class="page-heading page-shell"><p class="eyebrow">Selected work</p><h1>Useful outcomes over shiny launches.</h1></section>
<section class="case-grid page-shell"><% if (!items.length) { %><p class="empty-state">Published case studies will appear here soon.</p><% } %><% items.forEach((item) => { %><article><% if (item.image_key) { %><img class="content-image" src="<%= item.image_key %>" alt=""><% } %><p class="case-number">Case study</p><h2><%= item.title %></h2><p><%= item.summary %></p><% if (item.description) { %><p class="case-detail"><%= item.description %></p><% } %><% if (item.project_link) { %><a class="text-link" href="<%= item.project_link %>" target="_blank" rel="noopener">View project <span aria-hidden="true">↗</span></a><% } %></article><% }) %></section>
<%- include('../partials/foot') %>