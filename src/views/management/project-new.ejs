<%- include('../partials/head', { title, pageCss: 'contact' }) %>
<section class="contact-layout page-shell"><div><p class="eyebrow">Admin / new project</p><h1>Start a delivery workspace.</h1><p>Create a PostgreSQL-backed project for a client and make the portal available immediately.</p></div><form class="contact-form" action="/admin/projects" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><% if (project && project.error) { %><p class="form-message form-error"><%= project.error %></p><% } %><label for="client-id">Client</label><select id="client-id" name="clientId" required><option value="">Choose a client</option><% clients.forEach((client) => { %><option value="<%= client.id %>"><%= client.full_name %> · <%= client.email %></option><% }) %></select><label for="name">Project name</label><input id="name" name="name" required><label for="description">Description</label><textarea id="description" name="description" rows="5"></textarea><label for="status">Status</label><select id="status" name="status"><option value="pending">Pending</option><option value="active">Active</option><option value="on_hold">On hold</option><option value="completed">Completed</option></select><label for="progress">Progress percentage</label><input id="progress" name="progress" type="number" min="0" max="100" value="0"><label for="due-date">Due date</label><input id="due-date" name="dueDate" type="date"><button class="button button-dark" type="submit">Create project</button></form></section>
<%- include('../partials/foot') %>
