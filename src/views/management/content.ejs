<%- include('../partials/head', { title, pageCss: 'management-list' }) %>
<section class="page-heading page-shell"><p class="eyebrow">Admin / content</p><h1>Published content.</h1></section><section class="data-list page-shell"><h2>Portfolio</h2><% portfolio.forEach((item) => { %><article><div><strong><%= item.title %></strong><span><%= item.slug %></span></div><p><%= item.published ? 'Published' : 'Draft' %></p></article><% }) %><h2>Blog posts</h2><% posts.forEach((post) => { %><article><div><strong><%= post.title %></strong><span><%= post.slug %></span></div><p><%= post.published ? 'Published' : 'Draft' %></p></article><% }) %></section>
<%- include('../partials/foot') %>