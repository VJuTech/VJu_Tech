<%- include('../partials/head', { title, pageCss: 'content-admin' }) %>
<section class="page-heading page-shell"><p class="eyebrow">Admin / content library</p><h1>Shape what the world sees.</h1><p>Create drafts, publish polished work, and keep the public portfolio and insights pages current from one workspace.</p></section>
<section class="content-toolbar page-shell"><div><strong><%= portfolio.length + posts.length %></strong><span>Total entries</span></div><div><strong><%= portfolio.filter((item) => item.published).length + posts.filter((post) => post.published).length %></strong><span>Published</span></div><div><strong><%= portfolio.filter((item) => !item.published).length + posts.filter((post) => !post.published).length %></strong><span>Drafts</span></div><div class="content-actions"><a class="button button-dark" href="/admin/content/new/portfolio">New portfolio item <span aria-hidden="true">+</span></a><a class="button button-blue" href="/admin/content/new/blog">New blog post <span aria-hidden="true">+</span></a></div></section>
<section class="content-library page-shell"><div class="content-library-heading"><div><p class="eyebrow">Case studies</p><h2>Portfolio</h2></div><a href="/portfolio">View public page ↗</a></div><div class="content-cards"><% if (!portfolio.length) { %><p class="empty-state">No portfolio items yet. Add your first case study above.</p><% } %><% portfolio.forEach((item) => { %><article class="content-card"><div class="content-card-meta"><span class="content-type">Portfolio</span><span class="content-status <%= item.published ? 'is-published' : 'is-draft' %>"><%= item.published ? 'Published' : 'Draft' %></span></div><h3><%= item.title %></h3><p><%= item.summary || 'No summary added.' %></p><small>/<%= item.slug %> · Updated <%= new Date(item.updated_at).toLocaleDateString() %></small><div class="content-card-actions"><a href="/admin/content/portfolio/<%= item.id %>/edit">Edit</a><form action="/admin/content/portfolio/<%= item.id %>/delete" method="post" onsubmit="return confirm('Delete this portfolio item?');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Delete</button></form></div></article><% }) %></div></section>
<section class="content-library page-shell"><div class="content-library-heading"><div><p class="eyebrow">Ideas and perspective</p><h2>Blog posts</h2></div><a href="/blog">View public page ↗</a></div><div class="content-cards"><% if (!posts.length) { %><p class="empty-state">No blog posts yet. Add your first insight above.</p><% } %><% posts.forEach((post) => { %><article class="content-card"><div class="content-card-meta"><span class="content-type">Blog</span><span class="content-status <%= post.published ? 'is-published' : 'is-draft' %>"><%= post.published ? 'Published' : 'Draft' %></span></div><h3><%= post.title %></h3><p><%= post.excerpt || 'No excerpt added.' %></p><small>/<%= post.slug %> · Updated <%= new Date(post.updated_at).toLocaleDateString() %></small><div class="content-card-actions"><a href="/admin/content/blog/<%= post.id %>/edit">Edit</a><form action="/admin/content/blog/<%= post.id %>/delete" method="post" onsubmit="return confirm('Delete this blog post?');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Delete</button></form></div></article><% }) %></div></section>
<%- include('../partials/foot') %>