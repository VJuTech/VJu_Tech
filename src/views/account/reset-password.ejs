<%- include('../partials/head', { title, pageCss: 'reset-password' }) %>
<section class="auth-panel page-shell"><p class="eyebrow">Account recovery</p><h1>Choose a new password.</h1><% if (account && account.error) { %><p class="form-message form-error"><%= account.error %></p><% } %><form class="contact-form" action="/reset-password" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><input name="token" type="hidden" value="<%= token || '' %>"><label for="password">New password</label><input id="password" name="password" type="password" minlength="8" required><button class="button button-dark" type="submit">Update password</button></form></section>
<%- include('../partials/foot') %>