<%- include('../partials/head', { title, pageCss: 'forgot-password' }) %>
<section class="auth-panel page-shell"><p class="eyebrow">Account recovery</p><h1>Reset your password.</h1><% if (account && account.success) { %><p class="form-message form-success"><%= account.success %></p><% } %><form class="contact-form" action="/forgot-password" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><label for="email">Account email</label><input id="email" name="email" type="email" required><button class="button button-dark" type="submit">Send reset link</button></form><p class="account-switch"><a href="/login">Return to sign in</a></p></section>
<%- include('../partials/foot') %>