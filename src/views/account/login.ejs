<%- include('../partials/head', { title, pageCss: 'login' }) %>
<section class="auth-panel page-shell"><p class="eyebrow">Client portal</p><h1>Welcome back.</h1><% if (account && account.error) { %><p class="form-message form-error"><%= account.error %></p><% } %><form class="contact-form" action="/login" method="post"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><label for="email">Email</label><input id="email" name="email" type="email" required><label for="password">Password</label><input id="password" name="password" type="password" required><button class="button button-dark" type="submit">Sign in</button></form><p class="account-switch"><a href="/forgot-password">Forgot your password?</a></p><p class="account-switch">New to VJU Tech? <a href="/register">Create an account</a></p></section>
<%- include('../partials/foot') %>